# Copy this file to .env and adjust values for your machine.
# Do not commit .env.

# Preferred interpreter used by run.sh and validate_env.py
ML_PYTHON_PATH=/home/your-user/miniconda3/envs/ai/bin/python

# Optional: if ML_PYTHON_PATH is not set, run.sh can activate this conda env.
# ML_CONDA_ENV=base

# Phi local model path (relative to repository root or absolute path)
PHI_MODEL_PATH=Phi-3-mini-4k-instruct